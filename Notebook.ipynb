    "# Intialization\n",
    "A = A_fully_connected\n",
    "multipliers_0 = np.zeros([int(np.sum(A)/2),m]) # Initialization of the multipliers for dual decomposition\n",
    "n_iter = 50000\n",
    "egalizers_0 = np.zeros((int(np.sum(A)/2),m)) # Initialization of the egalizers for dual decomposition\n",
    "step_size = 0.1\n",
    "\n",
    "alphaDict={\"Dual Dec\": alpha_dualdecomp}\n",
    "\n",
    "for i in range (4):\n",
    "    key = \"ADMM beta=10e\" + str(i-1)\n",
    "    alpha_admm, multipliers_admm = ADMM(multipliers_0, egalizers_0, beta=step_size*10**i, K_a=K_a, K_mm=K_mm, y_a=y_a, A=np.ones([a,a])-np.eye(a), sigma=0.5, nu=1.0, max_iter=n_iter)\n",
    "    alphaDict[key] = alpha_admm\n",
    "\n",
    "\n",
    "make_gap_graph(alpha, alphaDict,pdf=True, title=\"files\\Comparison of Different Beta Values.pdf\",precisionlimit=5e-14)"
   ]
