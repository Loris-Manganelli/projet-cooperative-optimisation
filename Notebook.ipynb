    "sing=np.max(np.linalg.eigvalsh(AA@np.transpose(AA)))\n",
    "sing2=np.min(np.linalg.det(np.transpose(AA)@AA))\n",
    "print(sing)\n",
    "print(\"Dual 1/L: \",2*Conv_m/sing)\n"
   ]
  },
